<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:fitsSystemWindows="true">

    <!-- Top bar: rounded pill search field + tab count + menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_top_bar"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="10dp"
        android:paddingBottom="14dp">

        <!-- Phase 3: per-site privacy score, tap for a breakdown + network log -->
        <TextView
            android:id="@+id/privacyBadge"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_privacy_badge"
            android:gravity="center"
            android:textColor="@color/on_accent"
            android:textStyle="bold"
            android:textSize="13sp"
            android:text="–"
            android:contentDescription="@string/privacy_score_label" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_url_bar"
            android:paddingStart="12dp"
            android:paddingEnd="6dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_search_small"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/urlBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textColor="@color/text_light"
                android:textColorHint="@color/text_muted_light"
                android:textSize="14sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:hint="@string/url_hint" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnTabs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="4dp"
            android:padding="8dp"
            android:background="@drawable/bg_add_tab_button"
            android:contentDescription="@string/new_tab"
            android:src="@drawable/ic_add" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:padding="8dp"
            android:background="@drawable/ripple_icon_button"
            android:contentDescription="menu"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <!-- Horizontal tab strip -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabStrip"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/primary"
        android:clipToPadding="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:progressDrawable="@drawable/bg_progress_track"
        android:max="100"
        android:visibility="gone" />

    <!-- WebView container: each tab's WebView is added/removed here -->
    <FrameLayout
        android:id="@+id/webViewContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background_light" />

    <!-- Bottom navigation bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="6dp"
        android:gravity="center">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:padding="11dp"
            android:background="@drawable/ripple_icon_button"
            android:src="@drawable/ic_back"
            android:contentDescription="back" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:padding="11dp"
            android:background="@drawable/ripple_icon_button"
            android:src="@drawable/ic_forward"
            android:contentDescription="forward" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:padding="11dp"
            android:background="@drawable/ripple_icon_button"
            android:src="@drawable/ic_refresh"
            android:contentDescription="refresh" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:padding="11dp"
            android:background="@drawable/ripple_icon_button"
            android:src="@drawable/ic_home"
            android:contentDescription="home" />

    </LinearLayout>

</LinearLayout>
