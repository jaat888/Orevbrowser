<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/surface_light"
        android:elevation="1dp"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="10dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <TextView
            android:id="@+id/privacyBadge"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_privacy_badge"
            android:gravity="center"
            android:textColor="@color/on_accent"
            android:textStyle="bold"
            android:textSize="13sp"
            android:text="–"
            android:contentDescription="@string/privacy_score_label" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_url_bar"
            android:paddingStart="13dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_search_small"
                android:contentDescription="@null" />

            <EditText
                android:id="@+id/urlBar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:textColor="@color/text_light"
                android:textColorHint="@color/text_muted_light"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionGo"
                android:inputType="textUri"
                android:hint="@string/url_hint" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnTabs"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_add_tab_button"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/text_light"
            android:textStyle="bold"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/new_tab" />

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="2dp"
            android:padding="8dp"
            android:background="@drawable/ripple_icon_button"
            android:contentDescription="Menu"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/tabStrip"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@color/surface_light"
        android:clipToPadding="false"
        android:visibility="gone"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="3dp"
        android:paddingBottom="5dp"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:progressDrawable="@drawable/bg_progress_track"
        android:max="100"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:id="@+id/webViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_light" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_bottom_nav"
        android:elevation="5dp"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:maxWidth="64dp"
            android:padding="10dp"
            android:background="@drawable/ripple_icon_button"
            android:src="@drawable/ic_back"
            android:contentDescription="Back" />

        <ImageButton
            android:id="@+id/btnForward"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:maxWidth="64dp"
            android:padding="10dp"
            android:background="@drawable/ripple_icon_button"
            android:src="@drawable/ic_forward"
            android:contentDescription="Forward" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:maxWidth="64dp"
            android:padding="10dp"
            android:background="@drawable/ripple_icon_button"
            android:src="@drawable/ic_refresh"
            android:contentDescription="Refresh" />

        <ImageButton
            android:id="@+id/btnTools"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:maxWidth="64dp"
            android:padding="10dp"
            android:background="@drawable/ripple_icon_button"
            android:src="@drawable/ic_tools"
            android:contentDescription="Page tools" />

        <ImageButton
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:maxWidth="64dp"
            android:padding="10dp"
            android:background="@drawable/ripple_icon_button"
            android:src="@drawable/ic_home"
            android:contentDescription="Home" />
    </LinearLayout>

</LinearLayout>
