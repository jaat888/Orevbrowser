<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <application
        android:name=".PrivBrowseApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.PrivBrowse"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTop"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <activity-alias android:name=".ui.LauncherDefault" android:targetActivity=".ui.MainActivity" android:exported="true" android:icon="@drawable/ic_launcher" android:enabled="true" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".ui.LauncherTools" android:targetActivity=".ui.MainActivity" android:exported="true" android:icon="@drawable/ic_tools" android:enabled="false" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>
        <activity-alias android:name=".ui.LauncherHome" android:targetActivity=".ui.MainActivity" android:exported="true" android:icon="@drawable/ic_home" android:enabled="false" android:label="@string/app_name">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>

        <activity
            android:name=".ui.BookmarksActivity"
            android:exported="false"
            android:label="@string/bookmarks" />

        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/history" />

        <activity
            android:name=".ui.VpnActivity"
            android:exported="false"
            android:label="@string/vpn_menu" />

        <activity
            android:name=".ui.BrowserSettingsActivity"
            android:exported="false"
            android:label="Settings &amp; feature center" />

        <activity
            android:name=".ui.FeatureCenterActivity"
            android:exported="false"
            android:label="Feature Center" />

        <activity
            android:name=".ui.ReadingListActivity"
            android:exported="false"
            android:label="Reading list" />

        <activity
            android:name=".ui.Phase4Activity"
            android:exported="false"
            android:label="Advanced privacy" />

        <activity
            android:name=".ui.V2RayActivity"
            android:exported="false"
            android:label="V2Ray tunnels" />

        <activity
            android:name=".ui.AiCopilotActivity"
            android:exported="false"
            android:label="AI Copilot" />

        <activity
            android:name=".ui.VideoDownloadsActivity"
            android:exported="false"
            android:label="Video downloads" />

        <activity
            android:name=".ui.FeatureLabActivity"
            android:exported="false"
            android:label="Ultimate Feature Lab" />

        <activity
            android:name=".ui.NotesActivity"
            android:exported="false"
            android:label="Notes" />

        <activity
            android:name=".ui.CompareActivity"
            android:exported="false"
            android:label="Compare" />

        <activity
            android:name=".ui.TransparencyLogActivity"
            android:exported="false"
            android:label="@string/network_log" />

        <activity android:name=".ultimate.QrTransferActivity" android:exported="false" android:label="QR Tab Transfer" />
        <activity android:name=".ultimate.WatchActivity" android:exported="false" android:label="Page Alerts" />
        <activity android:name=".ultimate.DownloadQueueActivity" android:exported="false" android:label="Download Queue" />
        <activity android:name=".ultimate.PdfAnnotateActivity" android:exported="false" android:label="PDF Annotator" />
        <activity android:name=".ultimate.PrivacyDashboardActivity" android:exported="false" android:label="Weekly Privacy Report" />
        <activity android:name=".ultimate.ProfileActivity" android:exported="false" android:label="Browser Profiles" />
        <activity android:name=".ultimate.DashboardActivity" android:exported="false" android:label="Home Dashboard" />
        <activity android:name=".ultimate.RssActivity" android:exported="false" android:label="RSS Reader" />
        <activity android:name=".ultimate.GestureEditorActivity" android:exported="false" android:label="Custom Gestures" />
        <activity android:name=".ultimate.ThemeActivity" android:exported="false" android:label="Themes" />
        <activity android:name=".ultimate.BackupActivity" android:exported="false" android:label="Settings backup &amp; restore" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <receiver
            android:name=".transparency.WeeklyReportReceiver"
            android:exported="false" />

        <receiver
            android:name=".transparency.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>


        <service
            android:name=".v2ray.V2RayVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <meta-data
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="app_privacy_vpn_tunnel" />
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

        <service
            android:name=".v2ray.XrayWebViewProxyService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <meta-data
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="app_webview_proxy" />
        </service>

        <service
            android:name=".ultimate.FloatingBubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <meta-data android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" android:value="privbrowse_floating_bubble" />
        </service>

        <service
            android:name=".ultimate.DownloadQueueService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <service
            android:name=".ultimate.BackgroundAudioService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <service
            android:name=".vpn.PrivBrowseVpnService"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>

            <receiver android:name=".ultimate.PageWatchReceiver" android:exported="false" />
        <receiver android:name=".ultimate.BackupReceiver" android:exported="false">
            <intent-filter><action android:name="android.intent.action.BOOT_COMPLETED" /></intent-filter>
        </receiver>
        <receiver android:name=".ultimate.CleanupReceiver" android:exported="false" />
    </application>
</manifest>
